{
  "name": "payments-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Personal demo: Playwright + TypeScript API/UI test automation for a mock payments API",
  "scripts": {
    "start:mock": "tsx server/src/index.ts",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
